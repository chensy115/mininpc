# MiniWorld V1.6 reads environment variables from the process environment only.
# This file is documentation: do not paste a real key into it and do not commit secrets.
MINIWORLD_AGENT_API_KEY=
MINIWORLD_AGENT_BASE_URL=https://api.deepseek.com
MINIWORLD_AGENT_MODEL=set-an-explicit-compatible-model-name

# Conservative request controls
MINIWORLD_AGENT_TIMEOUT=12
MINIWORLD_AGENT_MAX_OUTPUT_TOKENS=1100
MINIWORLD_AGENT_TEMPERATURE=0.2
MINIWORLD_AGENT_MAX_ATTEMPTS=2
MINIWORLD_AGENT_RETRY_BASE_SECONDS=0.5
MINIWORLD_AGENT_MAX_CONCURRENCY=2
MINIWORLD_AGENT_TASK_MAX_CONCURRENCY=1
MINIWORLD_AGENT_ONLINE_QUEUE_LIMIT=20

# Calls and token guardrails (global, per NPC, and per task)
MINIWORLD_AGENT_CALLS_PER_MINUTE=6
MINIWORLD_AGENT_CALLS_PER_HOUR=30
MINIWORLD_AGENT_CALLS_PER_DAY=120
MINIWORLD_AGENT_CALLS_PER_NPC_HOUR=10
MINIWORLD_AGENT_CALLS_PER_NPC_DAY=30
MINIWORLD_AGENT_CALLS_PER_TASK_HOUR=20
MINIWORLD_AGENT_CALLS_PER_TASK_DAY=60
MINIWORLD_AGENT_INPUT_TOKENS_PER_DAY=120000
MINIWORLD_AGENT_OUTPUT_TOKENS_PER_DAY=30000
MINIWORLD_AGENT_TOTAL_TOKENS_PER_DAY=150000
MINIWORLD_AGENT_TOKENS_PER_NPC_DAY=40000
MINIWORLD_AGENT_TOKENS_PER_TASK_DAY=75000
MINIWORLD_AGENT_BUDGET_TIMEZONE=Asia/Shanghai

# Optional local cost estimate. No provider price is hard-coded.
# Leave all three unset if you do not want an estimate.
# MINIWORLD_AGENT_INPUT_PRICE_PER_MILLION=
# MINIWORLD_AGENT_OUTPUT_PRICE_PER_MILLION=
# MINIWORLD_AGENT_ESTIMATED_COST_PER_DAY=
MINIWORLD_AGENT_COST_CURRENCY=CNY

# Runtime starts in safe mode. A key never starts online calls by itself.
MINIWORLD_BACKGROUND_LOOPS_ENABLED=true
